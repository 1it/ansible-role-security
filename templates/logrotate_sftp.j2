# Managed by Ansible (ansible-role-security)

{{ security_ssh_sftp_log_path }} {
    daily
    rotate {{ security_ssh_sftp_logrotate_rotate }}
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate 2>/dev/null || /bin/kill -HUP $(cat /run/rsyslogd.pid 2>/dev/null) 2>/dev/null || true
    endscript
}
